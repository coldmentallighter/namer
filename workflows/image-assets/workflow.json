{
  "schema_version": 1,
  "id": "image-assets",
  "name": "图像素材工作流",
  "version": "1.0.0",
  "description": "根据图像尺寸提供方向、比例和像素面积候选值；复杂比例会自动吸附到最近的常见屏幕比例。",
  "builtin": true,
  "kind": "image-assets",
  "separator": "_",
  "name_modes": ["original"],
  "metadata_providers": [{"provider": "image_dimensions"}],
  "fields": [
    {"id": "orientation", "label": "方向", "scope": "record", "kind": "choice"},
    {"id": "aspect_ratio", "label": "比例", "scope": "record", "kind": "text", "extractor": "metadata.image.aspect_ratio_token"},
    {"id": "name", "label": "名称", "scope": "record", "kind": "text", "initial_source": "stem"}
  ],
  "derived": [
    {"id": "pixel_area", "expression": {"op": "multiply", "args": [
      {"path": "metadata.image.width"},
      {"path": "metadata.image.height"}
    ]}}
  ],
  "rules": [
    {
      "id": "image-landscape",
      "when": {"path": "metadata.image.orientation", "op": "equals", "value": "landscape"},
      "then": {"field": "orientation", "value": "横屏", "mode": "suggest", "reason": "图像宽度大于高度"}
    },
    {
      "id": "image-portrait",
      "when": {"path": "metadata.image.orientation", "op": "equals", "value": "portrait"},
      "then": {"field": "orientation", "value": "竖屏", "mode": "suggest", "reason": "图像高度大于宽度"}
    },
    {
      "id": "image-square",
      "when": {"path": "metadata.image.orientation", "op": "equals", "value": "square"},
      "then": {"field": "orientation", "value": "方形", "mode": "suggest", "reason": "图像宽高相等"}
    },
    {
      "id": "image-ratio",
      "when": {"path": "metadata.image.aspect_ratio_token", "op": "exists"},
      "then": {"field": "aspect_ratio", "value_from": "metadata.image.aspect_ratio_token", "mode": "suggest"}
    }
  ],
  "template": [{"field": "orientation"}, {"field": "aspect_ratio"}, {"field": "name"}],
  "suffix_modes": {},
  "suffix_options": [],
  "numbering": {"enabled": false, "field": "", "width": 2, "start": 1, "step": 1, "group_by": [], "manual": true, "skip_disk_existing": true}
}
