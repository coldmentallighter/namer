{
  "schema_version": 1,
  "id": "sample-pack",
  "name": "采样包工作流",
  "version": "2.0.0",
  "description": "以身份字段、资源 profile、音乐字段和独立编号语义组织采样包；默认仅处理 Audio 与 MIDI。",
  "builtin": true,
  "kind": "sample-pack",
  "separator": "_",
  "name_modes": ["original", "excel"],
  "excel_field": "name",
  "excel_placeholders": {
    "bpm": "metadata.sample_pack.bpm",
    "key_or_chord": "metadata.sample_pack.key_or_chord"
  },
  "metadata_providers": [{"provider": "sample_pack"}],
  "filename_parser": "sample_pack",
  "modules": [
    {
      "id": "sample_pack",
      "label": "分析 BPM 标签",
      "description": "调用采样包模块并将分析结果写入待确认候选值。",
      "trigger": "on_user_request",
      "outputs": [
        {"id": "bpm_tag", "scope": "record", "field": "bpm", "mode": "suggest", "format": "raw"},
        {"id": "tempo_tag", "scope": "record", "field": "qualifier", "mode": "suggest", "format": "raw"}
      ]
    }
  ],
  "resource_filter": {"include": ["audio", "midi"], "on_mismatch": "skip"},
  "actions": [],
  "fields": [
    {"id": "author_code", "label": "作者简写", "scope": "workflow", "kind": "text", "sources": ["filename", "manual"]},
    {"id": "pack_code", "label": "包名简写", "scope": "workflow", "kind": "text", "sources": ["filename", "manual"]},
    {"id": "author_full", "label": "作者全称（元数据）", "scope": "workflow", "kind": "text", "sources": ["manual", "excel"]},
    {"id": "pack_name_full", "label": "包名全称（元数据）", "scope": "workflow", "kind": "text", "sources": ["manual", "excel"]},
    {
      "id": "profile_id", "label": "资源 Profile", "scope": "record", "kind": "choice",
      "default": "generic", "autofill": true, "extractor": "record.parsed_fields.profile_id",
      "quick_tags": [
        {"label": "通用", "value": "generic"},
        {"label": "ColdLight 两段前缀", "value": "coldlight"},
        {"label": "Shaw / Tyan", "value": "shaw-tyan"},
        {"label": "Shaw BASS 编号", "value": "shaw-bass"},
        {"label": "Botanica 固定尾标", "value": "botanica"}
      ]
    },
    {"id": "delivery_type", "label": "交付类别", "scope": "record", "kind": "choice", "quick_tags": ["Loops", "Oneshots", "MIDI"]},
    {
      "id": "resource_type", "label": "资源类型", "scope": "record", "kind": "text",
      "autofill": true, "extractor": "record.parsed_fields.resource_type",
      "quick_tags": ["Drums", "Atmos", "Amb", "Bass", "BASS", "Key", "Keys", "Synth", "Syn", "Vocal", "Drone", "MIDI", "FX", "Impact", "Percussion", "Texture", "OneShot", "Found_Sound", "Melodic"]
    },
    {
      "id": "resource_subtype", "label": "资源子类型", "scope": "record", "kind": "text",
      "autofill": true, "extractor": "record.parsed_fields.resource_subtype",
      "quick_tags": ["Full", "Bass", "Melodic", "Tonal", "Ambience", "Combi", "Kick", "Snare", "Perc", "Top"]
    },
    {
      "id": "qualifier", "label": "附加限定词", "scope": "record", "kind": "text",
      "autofill": true, "extractor": "record.parsed_fields.qualifier",
      "quick_tags": ["GUI", "Granular", "SangXian", "Wet", "Dry", "Processed"]
    },
    {
      "id": "name", "label": "语义名称", "scope": "record", "kind": "text", "required": true, "initial_source": "stem",
      "autofill": true, "extractor": "record.parsed_fields.name",
      "quick_tags": ["Loop", "Fill", "Stem", "Swell", "Ambience"]
    },
    {"id": "asset_index", "label": "资产编号", "scope": "record", "kind": "number", "autofill": true, "extractor": "record.parsed_fields.asset_index"},
    {"id": "variant", "label": "名称变体", "scope": "record", "kind": "text", "autofill": true, "extractor": "record.parsed_fields.variant", "quick_tags": ["v1", "v2", "v3"]},
    {"id": "key_or_chord", "label": "调式 / 和弦原文", "scope": "record", "kind": "text", "autofill": true, "extractors": ["record.parsed_fields.key_or_chord", "metadata.sample_pack.key_or_chord"]},
    {"id": "bpm", "label": "BPM", "scope": "record", "kind": "number", "autofill": true, "extractors": ["record.parsed_fields.bpm", "metadata.sample_pack.bpm"], "normalizer": "sample_pack_bpm"}
  ],
  "profile_field": "profile_id",
  "default_profile": "generic",
  "profiles": [
    {
      "id": "coldlight", "label": "ColdLight / IrisEdge 两段前缀", "priority": 40,
      "ordered_segments": ["author_code", "pack_code", "resource_type", "resource_subtype", "qualifier", "name", "variant", "key_or_chord", "bpm"],
      "optional_segments": ["resource_subtype", "qualifier", "variant", "key_or_chord", "bpm"],
      "variant_style": "numeric-or-v",
      "parse_patterns": [
        "^(?P<author_code>CL)_(?P<pack_code>IE)_(?P<resource_type>[^_]+)(?:_(?P<resource_subtype>Full|Perc|Kick|Snare|Top|SangXian|Chords|Melody|Bass|Melodic|Tonal|Granular|GUI))?(?:_(?P<qualifier>Wet|Dry|Processed))?_(?P<name>.+?)(?:_(?P<variant>v?\\d{1,2}))?(?:_(?P<key_or_chord>[A-G](?:#|b)?(?:m|maj|min|minor|major|dim|aug|sus)?(?:\\d{1,2})?(?:add\\d{1,2})?(?:[-_][A-G](?:#|b)?(?:m|maj|min|minor|major|dim|aug|sus)?(?:\\d{1,2})?(?:add\\d{1,2})?)*|[A-G](?:#|b)?\\([A-G](?:#|b)?m?\\)|[A-G](?:#|b)?m?_over_[A-G](?:#|b)?m?))?(?:_(?P<bpm>(?:[2-9]\\d|[1-3]\\d{2}|400)))?$"
      ],
      "numbering": {"enabled": false}
    },
    {
      "id": "shaw-bass", "label": "Shaw / Tyan BASS 连续资产编号", "priority": 60,
      "ordered_segments": ["author_code", "pack_code", "resource_type", "asset_index", "name", "bpm", "key_or_chord"],
      "optional_segments": ["bpm", "key_or_chord"],
      "asset_index_style": "zero-padded-2",
      "parse_patterns": [
        "^(?P<author_code>Shaw)_(?P<pack_code>Tyan)_(?P<resource_type>BASS)_(?P<asset_index>\\d{2})_(?P<name>.+?)(?:_(?P<bpm>(?:[2-9]\\d|[1-3]\\d{2}|400)))?(?:_(?P<key_or_chord>[A-G](?:#|b)?(?:m|maj|min|minor|major|dim|aug|sus)?(?:\\d{1,2})?(?:add\\d{1,2})?(?:[-_][A-G](?:#|b)?(?:m|maj|min|minor|major|dim|aug|sus)?(?:\\d{1,2})?(?:add\\d{1,2})?)*|[A-G](?:#|b)?\\([A-G](?:#|b)?m?\\)|[A-G](?:#|b)?m?_over_[A-G](?:#|b)?m?))?$"
      ],
      "numbering": {"enabled": true, "field": "asset_index", "width": 2, "start": 1, "step": 1, "group_by": ["resource_type"], "manual": true, "skip_disk_existing": true}
    },
    {
      "id": "shaw-tyan", "label": "Shaw / Tyan 通用资源", "priority": 50,
      "ordered_segments": ["author_code", "pack_code", "resource_type", "name", "bpm", "key_or_chord", "variant"],
      "optional_segments": ["bpm", "key_or_chord", "variant"],
      "variant_style": "numeric-or-v",
      "parse_patterns": [
        "^(?P<author_code>Shaw)_(?P<pack_code>Tyan)_(?P<resource_type>[^_]+)_(?P<name>.+?)(?:_(?P<bpm>(?:[2-9]\\d|[1-3]\\d{2}|400)))?(?:_(?P<key_or_chord>[A-G](?:#|b)?(?:m|maj|min|minor|major|dim|aug|sus)?(?:\\d{1,2})?(?:add\\d{1,2})?(?:[-_][A-G](?:#|b)?(?:m|maj|min|minor|major|dim|aug|sus)?(?:\\d{1,2})?(?:add\\d{1,2})?)*|[A-G](?:#|b)?\\([A-G](?:#|b)?m?\\)|[A-G](?:#|b)?m?_over_[A-G](?:#|b)?m?))?(?:_(?P<variant>v?\\d{1,2}))?$"
      ],
      "numbering": {"enabled": false}
    },
    {
      "id": "botanica", "label": "Botanica 包名前缀与固定尾标", "priority": 70,
      "ordered_segments": ["pack_code", "resource_type", "resource_subtype", "qualifier", "bpm", "key_or_chord", "name", "variant"],
      "optional_segments": ["resource_subtype", "qualifier", "bpm", "key_or_chord", "variant"],
      "variant_style": "v-number", "fixed_suffix_tokens": ["FA"],
      "parse_patterns": [
        "^(?P<pack_code>BT)_(?P<resource_type>Found_Sound|Syn|Melodic|Impact)_(?P<resource_subtype>Ambience|Swell|Bass|Melodic|Combi|Tonal)(?:_(?P<qualifier>GUI|Granular))?(?:_(?P<bpm>(?:[2-9]\\d|[1-3]\\d{2}|400)))?(?:_(?P<key_or_chord>[A-G](?:#|b)?m?))?_(?P<name>.+?)(?:_(?P<variant>v\\d+))?_FA$",
        "^(?P<pack_code>BT)_(?P<resource_type>Found_Sound|Atmos|Key|Percussion|Impact|Melodic|Syn|Synth|Texture)(?:_(?P<qualifier>GUI|Granular))?(?:_(?P<bpm>(?:[2-9]\\d|[1-3]\\d{2}|400)))?(?:_(?P<key_or_chord>[A-G](?:#|b)?(?:m|maj|min|minor|major|dim|aug|sus)?(?:\\d{1,2})?(?:add\\d{1,2})?))?_(?P<name>.+?)(?:_(?P<variant>v\\d+))?_FA$"
      ],
      "numbering": {"enabled": false}
    },
    {
      "id": "generic", "label": "通用可选段", "priority": 0,
      "ordered_segments": ["author_code", "pack_code", "delivery_type", "resource_type", "resource_subtype", "qualifier", "name", "asset_index", "variant", "key_or_chord", "bpm"],
      "optional_segments": ["author_code", "pack_code", "delivery_type", "resource_type", "resource_subtype", "qualifier", "asset_index", "variant", "key_or_chord", "bpm"],
      "variant_style": "free", "asset_index_style": "manual", "numbering": {"enabled": false}
    }
  ],
  "template": [
    {"field": "author_code"}, {"field": "pack_code"}, {"field": "delivery_type"},
    {"field": "resource_type"}, {"field": "resource_subtype"}, {"field": "qualifier"},
    {"field": "name"}, {"field": "asset_index"}, {"field": "variant"},
    {"field": "key_or_chord"}, {"field": "bpm"}
  ],
  "suffix_modes": {},
  "suffix_options": [
    {"field": "key_or_chord", "label": "调式 / 和弦原文", "optional": true},
    {"field": "bpm", "label": "BPM", "optional": true}
  ],
  "numbering": {"enabled": false, "field": "", "width": 2, "start": 1, "step": 1, "group_by": [], "manual": true, "skip_disk_existing": true},
  "collision_suffix": {"enabled": true, "width": 2, "start": 1},
  "examples": [
    {"input": "CL_IE_Drums_Full_Loop_2_150.wav", "profile": "coldlight", "output": "CL_IE_Drums_Full_Loop_2_150.wav"},
    {"input": "Shaw_Tyan_BASS_01_Phaser_A.wav", "profile": "shaw-bass", "output": "Shaw_Tyan_BASS_01_Phaser_A.wav"},
    {"input": "BT_Syn_Melodic_130_Eb_Unifauna_v1_FA.wav", "profile": "botanica", "output": "BT_Syn_Melodic_130_Eb_Unifauna_v1_FA.wav"}
  ]
}
